{
  "name": "eastward-kr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src server tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --import tsx --test tests/server*.ts",
    "locale:import": "tsx --env-file-if-exists=.env server/import.ts",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx --env-file-if-exists=.env server/migrate.ts",
    "db:baseline": "prisma migrate resolve --applied 20261016000000_locale",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VriskaSerket51/eastward-kr.git"
  },
  "author": "IREVES",
  "license": "GPL-3.0-or-later",
  "description": "Eastward kr translation WEB",
  "dependencies": {
    "@heroui/button": "2.2.32",
    "@heroui/card": "2.2.28",
    "@heroui/checkbox": "2.3.32",
    "@heroui/divider": "2.2.24",
    "@heroui/input": "2.4.33",
    "@heroui/link": "2.2.26",
    "@heroui/navbar": "2.2.30",
    "@heroui/radio": "2.3.32",
    "@heroui/switch": "2.2.27",
    "@heroui/system": "2.4.28",
    "@heroui/theme": "2.4.26",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-aria/visually-hidden": "3.9.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "eastward.js": "file:../eastward.js",
    "framer-motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.13"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  },
  "workspaces": [
    "tools/eslint"
  ],
  "overrides": {
    "ts-api-utils": {
      "typescript": "6.0.3"
    }
  }
}
